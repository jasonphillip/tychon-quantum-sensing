# 02_import_ip.tcl — Import IP cores into Libero project
#
# Imports two IP blocks:
#   1. SmartHLS-generated PID controller (nv_pid_top) — from shls hw output
#   2. CoreVectorBlox V250 (v2.0.1) — from MegaVault IP Catalog
#
# CRITICAL: VectorBlox SDK v2.0.3 must match CoreVectorBlox IP v2.0.x
#           Do NOT use SDK v3.0 — major version mismatch risks silent AXI faults
#
# Prerequisites:
#   - 01_scaffold_proj.tcl has been sourced (project exists)
#   - shls hw has been run in hls/ (RTL generated)
#   - CoreVectorBlox free license merged with Libero Silver license
#
# Run on Beelink after shls hw:
#   cd <repo>/libero/scripts
#   source 02_import_ip.tcl

# ──────────────────────────────────────────────────────
# Path setup
# ──────────────────────────────────────────────────────
set SCRIPT_DIR  [file dirname [info script]]
set REPO_ROOT   [file normalize [file join $SCRIPT_DIR ../..]]
set PROJ_DIR    [file join $REPO_ROOT libero work]
set PROJ_FILE   [file join $PROJ_DIR tychon_polarfire_control.prjx]
set HLS_DIR     [file join $REPO_ROOT hls]

# ──────────────────────────────────────────────────────
# SmartHLS output path — where shls hw puts generated RTL
#
# VERIFY_AFTER_SHLS_HW: Confirm the actual output directory.
# SmartHLS 2025.2 typically generates output in one of:
#   hls/hls_output/
#   hls/output/
#   hls/<project_name>/
# Check after running shls hw and update HLS_OUTPUT_DIR.
# ──────────────────────────────────────────────────────
set HLS_OUTPUT_DIR [file join $HLS_DIR hls_output]

# VERIFY_AFTER_SHLS_HW: The top-level module name comes from the
# C++ function marked with #pragma HLS function top.
# In nv_pid.cpp this is nv_pid_top — confirm the generated
# Verilog file name matches.
set HLS_TOP_MODULE "nv_pid_top"

# ──────────────────────────────────────────────────────
# Open project
# ──────────────────────────────────────────────────────
puts "INFO: Opening project..."
open_project -file $PROJ_FILE

# ══════════════════════════════════════════════════════
# IP 1: SmartHLS-generated PID Controller
# ══════════════════════════════════════════════════════
#
# SmartHLS generates Verilog + a .cxf component descriptor.
# Two import methods (use whichever is available):
#
# Method A: Import the .cxf component file (preferred)
#   SmartHLS 2025.2 generates a Libero-compatible component
#   that can be instantiated directly in SmartDesign.
#
# Method B: Import raw Verilog and build hierarchy
#   If no .cxf is generated, import the HDL files directly.
#
# ──────────────────────────────────────────────────────

puts "INFO: Importing SmartHLS PID controller IP..."

# VERIFY_AFTER_SHLS_HW: Check which files shls hw actually generates.
# Look for a .cxf file first — if it exists, use Method A.
# If only .v files exist, use Method B.

# --- Method A: Component import (preferred) ---
# VERIFY_AFTER_SHLS_HW: Confirm .cxf file exists at this path
set HLS_CXF [file join $HLS_OUTPUT_DIR ${HLS_TOP_MODULE}.cxf]
if {[file exists $HLS_CXF]} {
    puts "INFO: Found SmartHLS component file: $HLS_CXF"
    import_component -file $HLS_CXF
} else {
    # --- Method B: Raw HDL import ---
    # VERIFY_AFTER_SHLS_HW: List the actual .v files generated by shls hw.
    # The glob below assumes all Verilog files in hls_output/ belong to the
    # PID module. If shls hw generates files in subdirectories, adjust paths.
    puts "INFO: No .cxf found, importing Verilog files directly..."

    set verilog_files [glob -nocomplain [file join $HLS_OUTPUT_DIR *.v]]
    if {[llength $verilog_files] == 0} {
        error "ERROR: No Verilog files found in $HLS_OUTPUT_DIR. Has shls hw been run?"
    }

    foreach vfile $verilog_files {
        puts "  Importing: [file tail $vfile]"
        import_files -hdl_source $vfile
    }

    # Build hierarchy so Libero discovers the module
    build_design_hierarchy
}

puts "INFO: SmartHLS PID controller imported (top module: $HLS_TOP_MODULE)"

# ══════════════════════════════════════════════════════
# IP 2: CoreVectorBlox V250 from MegaVault IP Catalog
# ══════════════════════════════════════════════════════
#
# CoreVectorBlox is Microchip's neural network accelerator IP.
# V250 is the smallest preset — targets the MPFS250T power budget.
#
# The VLNV (Vendor:Library:Name:Version) identifies the IP in
# Libero's catalog. Version must be 2.0.x to match SDK v2.0.3.
#
# VERIFY_AFTER_SHLS_HW: Check the actual CoreVectorBlox version
# available in MegaVault on the Beelink. Open Libero IP Catalog,
# search "CoreVectorBlox", and confirm the VLNV string below.
# ──────────────────────────────────────────────────────

puts "INFO: Downloading CoreVectorBlox from MegaVault..."

# VERIFY_AFTER_SHLS_HW: Confirm the VLNV. The vendor may be
# "Actel" or "Microsemi" or "Microchip" depending on Libero version.
# The version field must be 2.0.x (NOT 3.x).
set VBX_VLNV "Microsemi:SolutionCore:CoreVectorBlox:2.0.1"

# Download IP from vault (no-op if already cached locally)
download_core -vlnv $VBX_VLNV -location {vault}

# Create and configure the VectorBlox instance
# VERIFY_AFTER_SHLS_HW: Confirm parameter names and values.
# These are based on the VectorBlox SDK documentation and
# Icicle Kit reference design patterns.
create_and_configure_core \
    -core_vlnv $VBX_VLNV \
    -component_name {CoreVectorBlox_0} \
    -params { \
        "VSIZE:V250" \
    }

# VERIFY_AFTER_SHLS_HW: CoreVectorBlox may have additional
# parameters for AXI data width, memory interface, and clock
# configuration. Check the IP configuration GUI on Beelink:
#   1. Open IP Catalog → CoreVectorBlox
#   2. Click Configure
#   3. Note all parameter names and their values for V250 preset
#   4. Add any missing parameters to create_and_configure_core above
#
# Expected parameters to verify:
#   - AXI_DATA_WIDTH (likely 64 for FIC0)
#   - MEMORY_INIT (VNNX loading mode)
#   - CLOCK_FREQ (200 MHz to match fabric clock)

puts "INFO: CoreVectorBlox V250 configured"

# ══════════════════════════════════════════════════════
# IP 3: Clock and Reset Infrastructure
# ══════════════════════════════════════════════════════
#
# PolarFire SoC MSS provides clocks to the fabric via the
# Fabric CCC (Conditioning Circuitry). The 200 MHz fabric
# clock comes from the MSS reference clock through a PLL.
#
# VERIFY_AFTER_SHLS_HW: The Icicle Kit reference design uses
# a specific CCC configuration. Adapt from:
#   https://github.com/polarfire-soc/icicle-kit-reference-design
# ──────────────────────────────────────────────────────

puts "INFO: Configuring fabric clock conditioning..."

# Download PF_CCC (Clock Conditioning Circuitry)
download_core -vlnv {Actel:SgCore:PF_CCC:*} -location {vault}

# VERIFY_AFTER_SHLS_HW: Confirm PLL parameters for 200 MHz output.
# The reference clock from MSS is typically 125 MHz on Icicle Kit.
# PLL multiplier/divider values depend on the input reference.
create_and_configure_core \
    -core_vlnv {Actel:SgCore:PF_CCC:2.2.220} \
    -component_name {PF_CCC_0} \
    -params { \
        "PLL_IN_FREQ_0:125" \
        "GL0_0_IS_USED:true" \
        "GL0_0_OUT_FREQ:200" \
    }

# Download PF_INIT_MONITOR (fabric initialization and reset)
download_core -vlnv {Actel:SgCore:PF_INIT_MONITOR:*} -location {vault}

create_and_configure_core \
    -core_vlnv {Actel:SgCore:PF_INIT_MONITOR:2.0.307} \
    -component_name {PF_INIT_MONITOR_0} \
    -params {}

puts "INFO: Clock and reset infrastructure configured"

# ──────────────────────────────────────────────────────
# Verify imports
# ──────────────────────────────────────────────────────
build_design_hierarchy
save_project

puts ""
puts "========================================="
puts " IP import complete"
puts ""
puts " Components available for SmartDesign:"
puts "   $HLS_TOP_MODULE  — SmartHLS PID controller"
puts "   CoreVectorBlox_0 — V250 neural network accelerator"
puts "   PF_CCC_0         — 200 MHz fabric clock PLL"
puts "   PF_INIT_MONITOR_0 — Reset sequencing"
puts ""
puts " VERIFY_AFTER_SHLS_HW items to check:"
puts "   [ ] HLS output directory path correct"
puts "   [ ] HLS top module name matches generated Verilog"
puts "   [ ] CoreVectorBlox VLNV matches MegaVault catalog"
puts "   [ ] CoreVectorBlox V250 parameters complete"
puts "   [ ] PF_CCC PLL input/output frequencies correct"
puts "========================================="
puts ""
puts "Next step: source 03_smartdesign.tcl"
