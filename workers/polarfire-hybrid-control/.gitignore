# Libero SoC work directories
work/
ip_cache/
component/
simulation/
/stimulus/
designer/

# Allow HLS testbench stimulus directory
!hls/tb/stimulus/
smartgen/

# Synthesis outputs (committed selectively via libero/reports/)
*.job
*.stp

# VectorBlox compiled models (large binaries, not committed)
*.vnnx

# SmartHLS ap_fixpt software shim (local testbench only, not for synthesis)
hls/include/hls/

# Compiled test binaries
hls/tb_bumpless

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Logs
*.log
!libero/reports/*.log
!libero/reports/**/*.log
.build/

# Transient Libero report logs and run-log subdirs (kept locally on Beelink only)
libero/reports/_*.log
libero/reports/_run_logs/

# SmartHLS build outputs (regenerated on every hls-test)
hls/hls_output/
