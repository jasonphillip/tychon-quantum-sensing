# sim/modelsim_tb_actuator.do — two-slot actuator datapath bench (tb_actuator) on the
# generated SmartHLS RTL. iverilog cannot parse SmartHLS output (`input reg` ports), so this
# bench runs in QuestaSim/ModelSim on the build host.
#
# Usage (Beelink Git Bash, repo root):  vsim -c -do sim/modelsim_tb_actuator.do
# Pass: transcript contains "PASS: actuator datapath (0 errors)"; any mismatch calls $fatal.
# Precondition: hls/hls_output/rtl/*.v generated by `shls hw` from this checkout.

set RTL_DIR  "hls/hls_output/rtl"
set HDL_DIR  "libero/hdl"

if {![file exists "$RTL_DIR/nv_pid_top_nv_pid_top.v"]} {
    puts "FATAL: $RTL_DIR/nv_pid_top_nv_pid_top.v missing — run shls hw first"
    exit 1
}
vlog -sv "$RTL_DIR/nv_pid_top_nv_pid_top.v"
foreach v [glob -nocomplain "$RTL_DIR/*.v"] {
    if {[file tail $v] ne "nv_pid_top_nv_pid_top.v"} { vlog -sv $v }
}

vlog "$HDL_DIR/axi4_demux2.v"
vlog "$HDL_DIR/pid_csr_block.v"
vlog "$HDL_DIR/pid_csr_axi4_wrap.v"
vlog "$HDL_DIR/vbx_pulse_gen.v"
vlog "$HDL_DIR/watchdog_timer.v"
vlog "$HDL_DIR/pid_subsystem.v"

vlog -sv tests/two_slot_sim/tb_actuator.v

vsim -t ps -voptargs=+acc work.tb_actuator
run -all
quit -f
